LIVEAVATAR_API_KEY=your-api-key-here
LIVEAVATAR_API_BASE=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
LIVEAVATAR_CONTEXT_ID=

# Optional: required for image (non-video) avatars. Leave blank for video avatars.
LIVEAVATAR_VOICE_ID=

# Set to "true" only for the free sandbox avatar (dd73ea75-...). Custom / production
# avatars must NOT use sandbox mode — leave blank or set to "false".
LIVEAVATAR_SANDBOX=

# Set to 1 to force every visitor into the HeyGen fallback (testing only).
# Restart `netlify dev` (locally) or trigger a redeploy (Netlify) after toggling.
FORCE_API_DOWN=

# Set to 1 to disable rate limiting on the API endpoints. Local `netlify dev`
# already auto-disables it, so this is only needed to bypass on a deployed
# environment (e.g. for QA load tests).
RATE_LIMIT_DISABLED=

# SMTP for /api/email-transcript. Reuse AlexZAP's mailer config.
# See README "Email export setup" for how to generate a Gmail app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=no-reply@example.com

# Admin Basic Auth (Phase A). Single shared user/password gates /admin/* and
# /api/admin/* via the netlify/edge-functions/admin-auth.js Edge Function.
# Required in Netlify env; for local `netlify dev`, set here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# OpenAI — only required for the admin "Generate Reports" action (Phase F).
# Uses the Responses API; the prompt and JSON schema live in
# netlify/lib/openai-service.js (no separate Assistant configuration needed).
# OPENAI_REPORT_MODEL is optional and defaults to "gpt-4o-mini".
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=

# Salesforce CRM push (Phase G). Used by the "Push to Salesforce" button on the
# admin conversation detail page. Creates a Lead in Salesforce from the
# conversation + reports, then marks the conversation as `exported`.
#
# Reuses the same Connected App AlexZAP uses (OAuth 2.0 username-password
# flow). The password is your Salesforce password concatenated with the
# security token (no separator) — reset the token under Salesforce →
# Settings → Reset My Security Token if you don't have it.
#
# SALESFORCE_LOGIN_URL is optional. Defaults to https://login.salesforce.com.
# Override to https://test.salesforce.com for sandboxes.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_LOGIN_URL=

# Database (libSQL / Turso). Locally Prisma uses a plain SQLite file; in
# production this points at Turso (https://turso.tech).
#
# Local dev (default — no setup needed):
#   DATABASE_URL=file:./prisma/dev.db
#
# Turso production (after creating a database with `turso db create avatar-db`):
#   DATABASE_URL=libsql://<your-db>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create avatar-db`>
DATABASE_URL=file:./prisma/dev.db
TURSO_AUTH_TOKEN=
