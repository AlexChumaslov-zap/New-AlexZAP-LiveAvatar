LIVEAVATAR_API_KEY=your-api-key-here
LIVEAVATAR_API_BASE=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
LIVEAVATAR_CONTEXT_ID=

# Optional: required for image (non-video) avatars. Leave blank for video avatars.
LIVEAVATAR_VOICE_ID=

# Set to "true" only for the free sandbox avatar (dd73ea75-...). Custom / production
# avatars must NOT use sandbox mode — leave blank or set to "false".
LIVEAVATAR_SANDBOX=

# Set to 1 to force every visitor into the HeyGen fallback (testing only).
# In Amplify Gen 2: set via `npx ampx sandbox secret set FORCE_API_DOWN` for
# local, or in the Amplify Console (App settings → Secrets) for deployed.
FORCE_API_DOWN=

# Set to 1 to disable rate limiting on the API endpoints. Useful for QA load
# tests on staging. The in-memory limiter is per-Lambda-instance only, so
# concurrent Lambda containers each have their own bucket regardless.
RATE_LIMIT_DISABLED=

# SMTP for /api/email-transcript. Reuse AlexZAP's mailer config.
# See README "Email export setup" for how to generate a Gmail app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=no-reply@example.com

# Admin Basic Auth (Phase A). Single shared user/password gates /api/admin/*
# via lib/adminAuth.js inline check in each admin Lambda handler.
# In production: set via Amplify Console → App settings → Secrets.
# For local Amplify sandbox: `npx ampx sandbox secret set ADMIN_USERNAME` etc.
# This file is consumed only by local `npm run dev:frontend` + scripts/*.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# OpenAI — only required for the admin "Generate Reports" action (Phase F).
# Uses the Responses API; the prompt and JSON schema live in
# lib/openai-service.js (no separate Assistant configuration needed).
# OPENAI_REPORT_MODEL is optional and defaults to "gpt-4o-mini".
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=

# HubSpot CRM push (Phase G.2). Used by the "Push to HubSpot" button and the
# 4-hour cron job. Creates or updates a Contact by email with qualification summary in
# the standard `description` field. On success the conversation is marked
# `exported`.
#
# Token: generate in HubSpot → Settings → Integrations → Private Apps →
# Create app. Required scopes:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# Database (libSQL / Turso). Locally Prisma uses a plain SQLite file; in
# production this points at Turso (https://turso.tech).
#
# Local dev (default — no setup needed):
#   DATABASE_URL=file:./prisma/dev.db
#
# Turso production (after creating a database with `turso db create avatar-db`):
#   DATABASE_URL=libsql://<your-db>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create avatar-db`>
DATABASE_URL=file:./prisma/dev.db
TURSO_AUTH_TOKEN=
